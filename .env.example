# OpsPilot runtime configuration (copy to .env and fill in values; never commit .env)

# development | production | test
OPSPILOT_ENV=development

# groq = live Groq structured-output provider (requires GROQ_API_KEY)
# deterministic = local demo/reference provider with no external model API
OPSPILOT_MODEL_PROVIDER=groq

# Required when OPSPILOT_MODEL_PROVIDER=groq
GROQ_API_KEY=

# Optional Groq model override
GROQ_MODEL=openai/gpt-oss-20b

# Required when OPSPILOT_ENV=production
# Example local Docker: postgresql://opspilot:opspilot@localhost:5432/opspilot
DATABASE_URL=

# Comma-separated browser origins allowed to call the API
OPSPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# reference = deterministic simulator fixtures (CI/evaluation)
# live = running sandbox services with real telemetry
OPSPILOT_TELEMETRY_MODE=reference

# Required when OPSPILOT_TELEMETRY_MODE=live
# OPSPILOT_PROMETHEUS_URL=http://localhost:9090
# OPSPILOT_LOKI_URL=http://localhost:3100
# SANDBOX_CONTROL_TOKEN=sandbox-control-test-token

# Browser-visible backend URL for the Next.js frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
