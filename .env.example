# OpsPilot runtime configuration (copy to .env and fill in values; never commit .env)

# development | production | test
OPSPILOT_ENV=development

# groq = live Groq structured-output provider (requires GROQ_API_KEY)
# deterministic = local demo/reference provider with no external model API
OPSPILOT_MODEL_PROVIDER=groq

# Required when OPSPILOT_MODEL_PROVIDER=groq
GROQ_API_KEY=

# Optional Groq model override
GROQ_MODEL=openai/gpt-oss-20b
OPSPILOT_MODEL_FALLBACK=openai/gpt-oss-120b

# Required when OPSPILOT_ENV=production
# Example local Docker: postgresql://opspilot:opspilot@localhost:5432/opspilot
DATABASE_URL=

# Comma-separated browser origins allowed to call the API
OPSPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# reference = deterministic simulator fixtures (CI/evaluation)
# live = running sandbox services with real telemetry
OPSPILOT_TELEMETRY_MODE=reference

# Required when OPSPILOT_TELEMETRY_MODE=live
# OPSPILOT_PROMETHEUS_URL=http://localhost:9090
# OPSPILOT_LOKI_URL=http://localhost:3100
# SANDBOX_CONTROL_TOKEN=sandbox-control-test-token

# OPSPILOT_LOKI_URL=http://localhost:3100
# SANDBOX_CONTROL_TOKEN=sandbox-control-test-token

# Public sandbox hardening (live/public deployment)
# OPSPILOT_SESSION_COOKIE_SECURE=true
# OPSPILOT_LEASE_TTL_SECONDS=600
# OPSPILOT_INCIDENT_TTL_SECONDS=1800
# OPSPILOT_TURNSTILE_REQUIRED=false
# OPSPILOT_TURNSTILE_SECRET_KEY=
# OPSPILOT_TURNSTILE_SITE_KEY=
# OPSPILOT_SESSION_COOKIE_SAMESITE=none
# OPSPILOT_SESSION_COOKIE_DOMAIN=
# OPSPILOT_TRUST_PROXY_HEADERS=true
# OPSPILOT_QUOTA_MAX_LIVE_INCIDENTS_PER_SESSION=3
# OPSPILOT_QUOTA_MAX_MODEL_CALLS_PER_INCIDENT=5
# OPSPILOT_QUOTA_GLOBAL_DAILY_MODEL_CALL_CAP=500

# Browser talks to the Vercel/Next same-origin proxy. Server-only upstream:
OPSPILOT_API_TARGET=http://127.0.0.1:8000
# Public Turnstile site key (never the secret)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
