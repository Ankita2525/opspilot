# Production environment template — copy to .env on the VM; never commit real secrets.

OPSPILOT_ENV=production
OPSPILOT_MODEL_PROVIDER=groq
GROQ_API_KEY=PLACEHOLDER_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

OPSPILOT_TELEMETRY_MODE=live
OPSPILOT_PROMETHEUS_URL=http://prometheus:9090
OPSPILOT_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# Grafana Cloud Loki credentials via OTEL collector env (see docker-compose.prod.yml)

SANDBOX_CONTROL_TOKEN=PLACEHOLDER_STRONG_CONTROL_TOKEN

OPSPILOT_CORS_ORIGINS=https://your-frontend.vercel.app
OPSPILOT_PUBLIC_DOMAIN=sandbox.example.com

OPSPILOT_SESSION_COOKIE_SECURE=true
OPSPILOT_SESSION_COOKIE_SAMESITE=none
# OPSPILOT_SESSION_COOKIE_DOMAIN=.example.com
OPSPILOT_TRUST_PROXY_HEADERS=true
OPSPILOT_LEASE_TTL_SECONDS=600
OPSPILOT_INCIDENT_TTL_SECONDS=1800
OPSPILOT_CLEANUP_INTERVAL_SECONDS=30

OPSPILOT_TURNSTILE_REQUIRED=true
OPSPILOT_TURNSTILE_SECRET_KEY=PLACEHOLDER_TURNSTILE_SECRET
OPSPILOT_TURNSTILE_SITE_KEY=PLACEHOLDER_TURNSTILE_SITE_KEY

OPSPILOT_RATE_LIMIT_BURST_PER_IP=10
OPSPILOT_RATE_LIMIT_WINDOW_SECONDS=60
OPSPILOT_QUOTA_MAX_LIVE_INCIDENTS_PER_SESSION=3
OPSPILOT_QUOTA_MAX_MODEL_CALLS_PER_INCIDENT=5
OPSPILOT_QUOTA_MAX_MODEL_CALLS_PER_SESSION_PER_DAY=20
OPSPILOT_QUOTA_GLOBAL_DAILY_MODEL_CALL_CAP=500

CHECKOUT_API_URL=http://checkout-api:8081
AUTH_SERVICE_URL=http://auth-service:8082
PAYMENTS_SERVICE_URL=http://payments-service:8083

# OpsPilot runs one Uvicorn worker (see Dockerfile). Do not scale backend workers
# without PostgreSQL cleanup leader election.

NEXT_PUBLIC_API_BASE_URL=https://sandbox.example.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=PLACEHOLDER_TURNSTILE_SITE_KEY

# Optional Grafana Cloud Prometheus remote_write (verification uses local Prometheus)
# GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL=
# GRAFANA_CLOUD_PROMETHEUS_USERNAME=
# GRAFANA_CLOUD_PROMETHEUS_API_KEY=
