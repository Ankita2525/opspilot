# Public Ephemeral Live Incident Lab — Cloud Run profile (placeholders only).
# Do not commit real secrets. Use Secret Manager / Cloud Run secret refs in GCP.

OPSPILOT_ENV=production
OPSPILOT_DEPLOYMENT_PROFILE=ephemeral_live_lab
OPSPILOT_MODEL_PROVIDER=groq
OPSPILOT_TELEMETRY_MODE=live

# Ingress container (OpsPilot FastAPI)
OPSPILOT_PROMETHEUS_URL=http://127.0.0.1:9090
OPSPILOT_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1

# Localhost sidecar boundaries (shared network namespace)
CHECKOUT_API_URL=http://127.0.0.1:8081
AUTH_SERVICE_URL=http://127.0.0.1:8082
PAYMENTS_SERVICE_URL=http://127.0.0.1:8083
PROVIDER_SERVICE_URL=http://127.0.0.1:8084
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

SANDBOX_CONTROL_TOKEN=replace-with-random-token
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/opspilot?sslmode=require
GROQ_API_KEY=replace-with-groq-key
GROQ_MODEL=openai/gpt-oss-20b

OPSPILOT_CORS_ORIGINS=https://your-frontend.vercel.app
OPSPILOT_SESSION_COOKIE_SECURE=true
OPSPILOT_SESSION_COOKIE_SAMESITE=none
OPSPILOT_TRUST_PROXY_HEADERS=true
OPSPILOT_TURNSTILE_REQUIRED=true
OPSPILOT_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
OPSPILOT_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

GRAFANA_CLOUD_LOKI_ENDPOINT=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USERNAME=replace-with-grafana-user-id
GRAFANA_CLOUD_LOKI_API_KEY=replace-with-grafana-api-key

CHECKOUT_DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/checkout?sslmode=require
