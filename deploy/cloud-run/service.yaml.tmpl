# Cloud Run multi-container service — PUBLIC EPHEMERAL LIVE INCIDENT LAB
#
# Template — do not deploy directly. Render with:
#   python deploy/cloud-run/render_service.py --project-id ... --region ... --image-tag ...
#
# Only the opspilot container receives public ingress (containerPort 8000).
# Cloud Run injects PORT for that container; do not set reserved runtime env names.
# Sidecars listen on 0.0.0.0 for Cloud Run probes; clients dial http://127.0.0.1:<port>.

apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: opspilot-live-lab
  labels:
    opspilot_deployment_profile: ephemeral_live_lab
  annotations:
    run.googleapis.com/invoker-iam-disabled: "true"
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "1"
        run.googleapis.com/cpu-throttling: "true"
        run.googleapis.com/startup-cpu-boost: "true"
        run.googleapis.com/container-dependencies: '{"opspilot":["checkout-api","auth-service","payments-service","provider-service","prometheus","otel-collector"]}'
        run.googleapis.com/secrets: "opspilot-database-url:projects/{{PROJECT_ID}}/secrets/opspilot-database-url,opspilot-groq-api-key:projects/{{PROJECT_ID}}/secrets/opspilot-groq-api-key,opspilot-sandbox-control-token:projects/{{PROJECT_ID}}/secrets/opspilot-sandbox-control-token,opspilot-turnstile-secret:projects/{{PROJECT_ID}}/secrets/opspilot-turnstile-secret,opspilot-grafana-loki-authorization:projects/{{PROJECT_ID}}/secrets/opspilot-grafana-loki-authorization,opspilot-prometheus-config:projects/{{PROJECT_ID}}/secrets/opspilot-prometheus-config"
    spec:
      serviceAccountName: opspilot-cloud-run@{{PROJECT_ID}}.iam.gserviceaccount.com
      # Deliberate concurrency: global Postgres lease serializes live mutations;
      # allow concurrent read-only /ready, status, and provenance during SSE Request A.
      containerConcurrency: 10
      timeoutSeconds: 3600
      containers:
        - name: opspilot
          image: {{REGION}}-docker.pkg.dev/{{PROJECT_ID}}/opspilot/backend:{{IMAGE_TAG}}
          ports:
            - containerPort: 8000
          resources:
            limits:
              cpu: "2"
              memory: 2Gi
          env:
            - name: OPSPILOT_ENV
              value: production
            - name: OPSPILOT_DEPLOYMENT_PROFILE
              value: ephemeral_live_lab
            - name: OPSPILOT_MODEL_PROVIDER
              value: groq
            - name: OPSPILOT_TELEMETRY_MODE
              value: live
            - name: GROQ_MODEL
              value: openai/gpt-oss-20b
            - name: OPSPILOT_MODEL_FALLBACK
              value: openai/gpt-oss-120b
            - name: OPSPILOT_PROMETHEUS_URL
              value: http://127.0.0.1:9090
            - name: OPSPILOT_LOKI_URL
              value: "{{OPSPILOT_LOKI_URL}}"
            - name: OPSPILOT_LOKI_AUTHORIZATION
              valueFrom:
                secretKeyRef:
                  name: opspilot-grafana-loki-authorization
                  key: "{{OPSPILOT_GRAFANA_LOKI_SECRET_VERSION}}"
            - name: CHECKOUT_API_URL
              value: http://127.0.0.1:8081
            - name: AUTH_SERVICE_URL
              value: http://127.0.0.1:8082
            - name: PAYMENTS_SERVICE_URL
              value: http://127.0.0.1:8083
            - name: PROVIDER_SERVICE_URL
              value: http://127.0.0.1:8084
            - name: OPSPILOT_CORS_ORIGINS
              value: "{{OPSPILOT_CORS_ORIGINS}}"
            - name: OPSPILOT_SESSION_COOKIE_SECURE
              value: "true"
            - name: OPSPILOT_SESSION_COOKIE_SAMESITE
              value: none
            - name: OPSPILOT_TRUST_PROXY_HEADERS
              value: "true"
            - name: OPSPILOT_LEASE_TTL_SECONDS
              value: "240"
            - name: OPSPILOT_INCIDENT_TTL_SECONDS
              value: "240"
            - name: OPSPILOT_APPROVAL_TIMEOUT_SECONDS
              value: "240"
            - name: OPSPILOT_FAULT_TTL_SECONDS
              value: "300"
            - name: OPSPILOT_TURNSTILE_REQUIRED
              value: "true"
            - name: OPSPILOT_TURNSTILE_SITE_KEY
              value: "{{OPSPILOT_TURNSTILE_SITE_KEY}}"
            - name: OPSPILOT_PUBLIC_DOMAIN
              value: "{{OPSPILOT_PUBLIC_DOMAIN}}"
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: opspilot-database-url
                  key: "{{OPSPILOT_DATABASE_SECRET_VERSION}}"
            - name: GROQ_API_KEY
              valueFrom:
                secretKeyRef:
                  name: opspilot-groq-api-key
                  key: "{{OPSPILOT_GROQ_SECRET_VERSION}}"
            - name: SANDBOX_CONTROL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: opspilot-sandbox-control-token
                  key: "{{OPSPILOT_SANDBOX_TOKEN_SECRET_VERSION}}"
            - name: SANDBOX_FAULT_TTL_SECONDS
              value: "300"
            - name: OPSPILOT_TURNSTILE_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: opspilot-turnstile-secret
                  key: "{{OPSPILOT_TURNSTILE_SECRET_VERSION}}"
          # Lifecycle probes must stay process-local (/health). Deep /ready is diagnostic only.
          # Do not use exact path /healthz: Google Frontend intercepts public /healthz with HTML 404
          # before the request reaches the container (rev 00004 evidence). Internal probes can still
          # hit /healthz, but public/frontend checks must use /health.
          startupProbe:
            httpGet:
              path: /health
              port: 8000
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 24
          livenessProbe:
            httpGet:
              path: /health
              port: 8000
            periodSeconds: 30
            timeoutSeconds: 2

        - name: checkout-api
          image: {{REGION}}-docker.pkg.dev/{{PROJECT_ID}}/opspilot/sandbox:{{IMAGE_TAG}}
          command: ["uvicorn", "sandbox.checkout.app:app", "--host", "0.0.0.0", "--port", "8081"]
          resources:
            limits:
              cpu: "1"
              memory: 512Mi
          env:
            - name: SANDBOX_SERVICE_NAME
              value: checkout-api
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: http://127.0.0.1:4318
            - name: CHECKOUT_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: opspilot-database-url
                  key: "{{OPSPILOT_DATABASE_SECRET_VERSION}}"
            - name: SANDBOX_CONTROL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: opspilot-sandbox-control-token
                  key: "{{OPSPILOT_SANDBOX_TOKEN_SECRET_VERSION}}"
            - name: SANDBOX_FAULT_TTL_SECONDS
              value: "300"
          startupProbe:
            httpGet:
              path: /health
              port: 8081
            periodSeconds: 5
            failureThreshold: 18

        - name: auth-service
          image: {{REGION}}-docker.pkg.dev/{{PROJECT_ID}}/opspilot/sandbox:{{IMAGE_TAG}}
          command: ["uvicorn", "sandbox.auth.app:app", "--host", "0.0.0.0", "--port", "8082"]
          resources:
            limits:
              cpu: "1"
              memory: 256Mi
          env:
            - name: SANDBOX_SERVICE_NAME
              value: auth-service
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: http://127.0.0.1:4318
            - name: SANDBOX_CONTROL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: opspilot-sandbox-control-token
                  key: "{{OPSPILOT_SANDBOX_TOKEN_SECRET_VERSION}}"
            - name: SANDBOX_FAULT_TTL_SECONDS
              value: "300"
          startupProbe:
            httpGet:
              path: /health
              port: 8082
            periodSeconds: 5
            failureThreshold: 18

        - name: payments-service
          image: {{REGION}}-docker.pkg.dev/{{PROJECT_ID}}/opspilot/sandbox:{{IMAGE_TAG}}
          command: ["uvicorn", "sandbox.payments.app:app", "--host", "0.0.0.0", "--port", "8083"]
          resources:
            limits:
              cpu: "1"
              memory: 256Mi
          env:
            - name: SANDBOX_SERVICE_NAME
              value: payments-service
            - name: PROVIDER_SERVICE_URL
              value: http://127.0.0.1:8084
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: http://127.0.0.1:4318
            - name: SANDBOX_CONTROL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: opspilot-sandbox-control-token
                  key: "{{OPSPILOT_SANDBOX_TOKEN_SECRET_VERSION}}"
            - name: SANDBOX_FAULT_TTL_SECONDS
              value: "300"
          startupProbe:
            httpGet:
              path: /health
              port: 8083
            periodSeconds: 5
            failureThreshold: 18

        - name: provider-service
          image: {{REGION}}-docker.pkg.dev/{{PROJECT_ID}}/opspilot/sandbox:{{IMAGE_TAG}}
          command: ["uvicorn", "sandbox.provider.app:app", "--host", "0.0.0.0", "--port", "8084"]
          resources:
            limits:
              cpu: "1"
              memory: 256Mi
          env:
            - name: SANDBOX_SERVICE_NAME
              value: provider-service
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: http://127.0.0.1:4318
            - name: SANDBOX_CONTROL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: opspilot-sandbox-control-token
                  key: "{{OPSPILOT_SANDBOX_TOKEN_SECRET_VERSION}}"
            - name: SANDBOX_FAULT_TTL_SECONDS
              value: "300"
          startupProbe:
            httpGet:
              path: /health
              port: 8084
            periodSeconds: 5
            failureThreshold: 18

        - name: prometheus
          image: prom/prometheus:v3.2.1
          args:
            - --config.file=/etc/prometheus/prometheus.yml
            - --storage.tsdb.path=/tmp/prometheus
            - --web.listen-address=0.0.0.0:9090
          resources:
            limits:
              cpu: "1"
              memory: 512Mi
          volumeMounts:
            - name: prometheus-config
              mountPath: /etc/prometheus
              readOnly: true
          startupProbe:
            httpGet:
              path: /-/ready
              port: 9090
            periodSeconds: 5
            failureThreshold: 18

        - name: otel-collector
          image: otel/opentelemetry-collector-contrib:0.120.0
          args: ["--config=env:OTEL_COLLECTOR_CONFIG"]
          resources:
            limits:
              cpu: "1"
              memory: 256Mi
          env:
            - name: OTEL_COLLECTOR_CONFIG
              value: |
{{OTEL_COLLECTOR_CONFIG_BLOCK}}
            - name: OPSPILOT_LOKI_AUTHORIZATION
              valueFrom:
                secretKeyRef:
                  name: opspilot-grafana-loki-authorization
                  key: "{{OPSPILOT_GRAFANA_LOKI_SECRET_VERSION}}"
          startupProbe:
            tcpSocket:
              port: 4318
            timeoutSeconds: 1
            periodSeconds: 5
            failureThreshold: 18

      volumes:
        - name: prometheus-config
          secret:
            secretName: opspilot-prometheus-config
            items:
              - key: "{{OPSPILOT_PROMETHEUS_CONFIG_SECRET_VERSION}}"
                path: prometheus.yml
